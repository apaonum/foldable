{
  "name": "foldable",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "bootstrap:sync": "pnpm --filter @foldablejs/core build && cp packages/core/dist-iife/bootstrap.iife.js Sources/Foldable/Resources/bootstrap.js",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @foldablejs/core build && FOLDABLE_CORE_BUILT=1 pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.ts",
    "release:bump": "node scripts/release.ts bump",
    "release:check": "node scripts/release.ts check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}

{
  "name": "@foldablejs/core",
  "version": "0.0.0",
  "description": "Fold-aware state and CSS for web content on iPhone Duo.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.mts",
      "default": "./dist/bootstrap.mjs"
    },
    "./primitives.css": "./dist/primitives.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project webkit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.64.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
